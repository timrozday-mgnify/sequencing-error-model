// Site config for workflows/hpc on a Slurm cluster with Singularity (from kmer-functional-profiler's
// kfp-ablations/site.config). Relative paths resolve against the launch directory: a run directory
// <runs>/sem-hpc/<run>/, so '..' is sem-hpc/.
params {
    // Uncomment when Nextflow cannot stage from ENA itself ('Connection refused'): fetch the two FASTQs
    // where that works, e.g. a login node (README). Local paths also make a re-run skip the 1.5 GB.
    // r1     = '../data/SRR24523812_1.fastq.gz'
    // r2     = '../data/SRR24523812_2.fastq.gz'
    assembly  = '../data/SRR24523812_contigs.fa'  // copied from the shovill run (README)
    container = '../containers/sem-tools.sif'     // built from build.sh's sem-tools.tar (README);
                                                  // an absolute path if the run dir is not the launch dir
}

process.cache = 'lenient'
// process.queue = '<partition>'
// process.clusterOptions = '--account=<account>'

singularity {
    cacheDir = '../singularity_cache'
    // runOptions = "-B <repo>/src:/app/src -B <path>"  // keep the src bind if data sit outside the auto-mounts
}

// Also retry Slurm node failures and preemption (the sweep label keeps its own 'ignore' strategy).
process.errorStrategy = {
    if (task.previousException?.toString()?.contains('terminated for an unknown reason')) return 'retry'  // NODE_FAIL
    if (task.exitStatus in ((130..145) + 104) && task.attempt <= 2) return 'retry'
    return 'finish'
}
