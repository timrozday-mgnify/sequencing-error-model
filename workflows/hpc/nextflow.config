params {
    outdir      = 'results'
    real        = true
    // SRR24523812 (phase 5/6 near-clonal isolate) and its shovill assembly, which is not public: copy
    // contigs.fa to shared storage and pass --assembly.
    r1          = 'https://ftp.sra.ebi.ac.uk/vol1/fastq/SRR245/012/SRR24523812/SRR24523812_1.fastq.gz'
    r2          = 'https://ftp.sra.ebi.ac.uk/vol1/fastq/SRR245/012/SRR24523812/SRR24523812_2.fastq.gz'
    assembly    = null
    // Read selection, not read count, is what the strides below control: SRR24523812_1.fastq.gz holds
    // 8,039,657 pairs, so every 100th is ~80,400 (phase 6's subset size, ~15x) and every 8th ~1,005,000
    // (its depth slice, ~37x). Both span the whole run, so they differ in depth and not in selection -
    // phase 6 took them as two different contiguous blocks, which is worth up to 2.5x on its own
    // (phase 6b item 2). Recount with `gzip -dc r1 | wc -l` if the dataset changes.
    every_n       = 100
    depth_every_n = 8       // 0 to skip the depth slice
    train_pairs   = 20000   // pe-overlap pairs and reference reads (x2), as in phase 6
    train_every_n = 4       // ~80,400 subset pairs down to train_pairs, again by stride and not by head
    k           = '17,21,31'
    v           = 13
    c           = 8
    latent      = '0,2,3'   // reference specs; 2 and 3 are the sweep's Latent truths
    sweep       = "${projectDir}/sweeps/phase6b.csv"
    skiver      = 'skiver'
    container   = 'sem-tools:latest'  // build.sh's tag locally; the .sif path on HPC
}

// The repo's code comes from this checkout, bound over the image's empty editable install (Dockerfile).

process {
    container     = { params.container }
    errorStrategy = { task.exitStatus in 137..140 ? 'retry' : 'finish' }
    maxRetries    = 2
    withLabel: 'small'  { cpus = 1; memory = { 2.GB * task.attempt };  time = { 2.h * task.attempt } }
    withLabel: 'medium' { cpus = 8; memory = { 16.GB * task.attempt }; time = { 6.h * task.attempt } }
    // Latent(3) on 40,000 reads took 5 h and under 18 GB locally (phase 5).
    withLabel: 'fit'    { cpus = 4; memory = { 32.GB * task.attempt }; time = { 16.h * task.attempt } }
    // A broken sweep row is logged and skipped rather than stopping the rest.
    withLabel: 'sweep'  {
        cpus = 4; memory = { 8.GB * task.attempt }; time = { 8.h * task.attempt }
        errorStrategy = { task.exitStatus in 137..140 && task.attempt <= 2 ? 'retry' : 'ignore' }
    }
}

// BLAS would otherwise start a thread per core on the node, not per Slurm cpu.
// ponytail: one fixed value; set per label if the fits turn out BLAS-bound.
env.OMP_NUM_THREADS = '4'
env.OPENBLAS_NUM_THREADS = '4'

profiles {
    docker {
        docker.enabled    = true
        docker.runOptions = "--platform linux/amd64 -v ${projectDir}/../../src:/app/src"
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        singularity.runOptions = "-B ${projectDir}/../../src:/app/src"
    }
    slurm {
        executor.name              = 'slurm'
        executor.queueSize         = 75
        executor.queueGlobalStatus = true
        executor.submitRateLimit   = '10 sec'
        executor.pollInterval      = '30 sec'
    }
    // On a laptop, no container: one k, small fits, two sweep rows (uses the local .venv and skiver).
    test {
        params.train_pairs   = 1000  // skiver still needs the subset's own coverage; only the fits shrink
        params.train_every_n = 80
        params.depth_every_n = 0
        params.k           = '21'
        params.latent      = '0,2'
        params.sweep       = "${projectDir}/sweeps/test.csv"
        params.skiver      = 'skiver-0.3.2'
        params.outdir      = 'results-test'
        env.PATH           = "${projectDir}/../../.venv/bin:\$PATH"
        process.container  = null
        process.resourceLimits = [cpus: 4, memory: 8.GB]
    }
}

manifest {
    name            = 'sequencing-error-model/hpc'
    nextflowVersion = '>=25.04'
}
