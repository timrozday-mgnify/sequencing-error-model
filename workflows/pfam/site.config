// Site settings for workflows/pfam. preflight.sh writes <runs>/sem-pfam/site.config from this layout (README step 2); edit by hand only if it cannot.
// B11 and B9 are the directories of the kfpfam and Zymo work (nar-review-response/hpc).
// CHANGE: every path below.
params {
    container        = '/hps/nobackup/CHANGE/sequencing-error-model_runs/sem-hpc/containers/sem-tools.sif'
    filter_container = '/CHANGE/B11_pfam_arms/kfpfam/kfpfam-filter.sif'     // kfpfam_setup.sh's output, with the next two
    prep     = '/CHANGE/B11_pfam_arms/kfpfam/prep'
    index    = '/CHANGE/B11_pfam_arms/kfpfam/index/k4T6.5.tidx'
    hmm      = '/hps/nobackup/CHANGE/nar-review-B11/pfam/39.0/Pfam-A.hmm'   // the file prep was built from
    pairs_py = '/CHANGE/kfpfam/recruit/pairs.py'                            // a kfpfam checkout
    genomes  = [
        std    : '/hps/nobackup/CHANGE/nar-review-B9/truth/refs/std/refs.fna',    // B9's truth.sh refs
        d6331  : '/hps/nobackup/CHANGE/nar-review-B9/truth/refs/d6331/refs.fna',
        isolate: '/hps/nobackup/CHANGE/sequencing-error-model_runs/sem-hpc/data/SRR24523812_contigs.fa',
    ]
    // fastq_dir = '/CHANGE/fastq'                                          // if the head job cannot reach ENA (README)
}
process.cache = 'lenient'
// process.queue = '<partition>'
// process.clusterOptions = '--account=<account>'
singularity.cacheDir = '../singularity_cache'
// Also retry node failures and preemption.
process.errorStrategy = {
    if (task.previousException?.toString()?.contains('terminated for an unknown reason')) return 'retry'
    if (task.exitStatus in ((130..145) + 104) && task.attempt <= 2) return 'retry'
    return 'finish'
}
