params {
    outdir        = 'results'
    runs          = "${projectDir}/runs.csv"   // run,every_n,r1,r2,genomes
    only          = null                       // run accessions, comma separated
    fastq_dir     = null                       // FASTQs already on disk, under their ENA names; else staged from the URL
    genomes       = [:]                        // per runs.csv's `genomes` name: the FASTA of everything in the library
    doses         = '0.002,0.01'
    max_pairs     = null                       // for trials
    quality_every = 100                        // head Q from every 100th pair: 1 M bases is plenty
    t1            = 35
    t2            = 6
    // kfpfam: its prep directory and k4T6.5 index, the HMMs both were built from, and recruit/pairs.py of a checkout
    prep          = null
    index         = null
    hmm           = null
    pairs_py      = null
    // Mode A, as the laptop runs (plan section 3)
    bar           = 17
    gate          = 16.5
    gapped        = 21.25
    filter_bin     = 'filter'
    pyhmmer_python = 'python3'
    container        = 'sem-tools:latest'      // workflows/hpc's image: the .sif path on HPC
    filter_container = 'kfpfam-filter:latest'  // kfpfam's docker/filter.Dockerfile
}

process {
    container     = { params.container }
    errorStrategy = { task.exitStatus in 137..140 ? 'retry' : 'finish' }
    maxRetries    = 2
    withLabel: 'small'  { cpus = 1; memory = { 8.GB * task.attempt };  time = { 8.h * task.attempt } }
    withLabel: 'search' {
        container = { params.filter_container }
        cpus = 16; memory = { 48.GB * task.attempt }; time = { 24.h * task.attempt }
    }
    withLabel: 'align'  { cpus = 8; memory = { 16.GB * task.attempt }; time = { 6.h * task.attempt } }
    withLabel: 'fit'    { cpus = 4; memory = { 64.GB * task.attempt }; time = { 24.h * task.attempt } }
    withLabel: 'score'  { cpus = 2; memory = { 128.GB * task.attempt }; time = { 24.h * task.attempt } }
}

// BLAS would otherwise start a thread per core on the node, not per Slurm cpu.
env.OMP_NUM_THREADS = '4'
env.OPENBLAS_NUM_THREADS = '4'

profiles {
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        // the repo's code comes from this checkout, bound over the image's empty install (workflows/hpc/Dockerfile)
        singularity.runOptions = "-B ${projectDir}/../../src:/app/src"
    }
    slurm {
        executor.name              = 'slurm'
        executor.queueSize         = 75
        executor.queueGlobalStatus = true
        executor.submitRateLimit   = '10 sec'
        executor.pollInterval      = '30 sec'
    }
    // On a laptop, no container: the local .venv, and kfpfam's own binary and pyhmmer passed as --filter_bin/--pyhmmer_python.
    test {
        params.outdir    = 'results-test'
        params.max_pairs = 2000
        params.doses     = '0.01'
        params.quality_every = 5
        env.PATH         = "${projectDir}/../../.venv/bin:\$PATH"
        env.PYTHONPATH   = "${projectDir}/../../src"
        process.container = null
        process.maxForks  = 1
        process.resourceLimits = [cpus: 4, memory: 6.GB]
    }
}

manifest {
    name            = 'sequencing-error-model/pfam'
    nextflowVersion = '>=25.04'
}
